{
  "name": "@tkey/default",
  "version": "17.2.1",
  "description": "TKey default library",
  "main": "dist/lib.cjs/index.js",
  "module": "dist/lib.esm/index.js",
  "unpkg": "dist/lib.esm/index.js",
  "jsdelivr": "dist/lib.esm/index.js",
  "types": "dist/lib.cjs/index.d.ts",
  "sideEffects": false,
  "scripts": {
    "test": "vp test run --config test/configs/node.config.mts --coverage",
    "test:full": "cross-env TKEY_FULL=1 vp test run --config test/configs/node.config.mts",
    "coverage": "vp test run --config test/configs/node.config.mts --coverage",
    "coverage-production": "vp test run --config test/configs/node.prod.config.mts --coverage",
    "test-development": "vp test run --config test/configs/node.dev.config.mts",
    "test-production": "vp test run --config test/configs/node.prod.config.mts",
    "test-debugger": "vp test run --config test/configs/node.debug.config.mts --inspect-brk",
    "browser-tests:local-mocked": "vp test run --config test/configs/browsers.config.mts",
    "browser-tests:local-dev": "vp test run --config test/configs/browsers.dev.config.mts",
    "browser-tests:local-prod": "vp test run --config test/configs/browsers.prod.config.mts",
    "browser-tests:cloud-mocked": "vp test run --config test/configs/browsers.config.mts",
    "browser-tests:cloud-prod": "vp test run --config test/configs/browsers.prod.config.mts",
    "dev": "vp pack --watch",
    "build": "vp pack",
    "lint": "vp lint",
    "prepack": "npm run build",
    "pre-commit": "lint-staged"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tkey/tkey.git"
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "@tkey/common-types": "^17.2.0",
    "@tkey/core": "^17.2.0",
    "@tkey/service-provider-base": "^17.2.0",
    "@tkey/service-provider-torus": "^17.2.0",
    "@tkey/share-serialization": "^17.2.1",
    "@tkey/share-transfer": "^17.2.0",
    "@tkey/storage-layer-torus": "^17.2.0"
  },
  "devDependencies": {
    "@tkey/private-keys": "^17.2.0",
    "@tkey/security-questions": "^17.2.0",
    "@tkey/seed-phrase": "^17.2.1",
    "@toruslabs/eccrypto": "^8.0.0",
    "@toruslabs/http-helpers": "^10.0.0",
    "viem": "^2.47.5"
  },
  "lint-staged": {
    "!(*d).ts": [
      "vp fmt",
      "vp lint --fix"
    ]
  },
  "publishConfig": {
    "access": "public"
  },
  "author": "Torus Labs",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/tkey/tkey/issues"
  },
  "homepage": "https://github.com/tkey/tkey#readme",
  "keywords": [
    "customauth",
    "torus-threshold-bak",
    "threshold-bak",
    "torus nodes",
    "torus-embed",
    "direct auth",
    "tkey"
  ],
  "engines": {
    "node": ">=24.22.0",
    "npm": ">=12"
  },
  "gitHead": "4ff88f7fe92b8c85bd0bfde069cde2e56005faca",
  "devEngines": {
    "packageManager": {
      "name": "npm",
      "version": ">=11.17.0",
      "onFail": "error"
    }
  }
}
