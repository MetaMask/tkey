{
  "name": "@tkey/storage-layer-torus",
  "version": "17.2.0",
  "description": "TKey Torus Storage Layer Module",
  "author": "Torus Labs",
  "homepage": "https://github.com/tkey/tkey#readme",
  "license": "MIT",
  "main": "dist/lib.cjs/index.js",
  "module": "dist/lib.esm/index.js",
  "unpkg": "dist/lib.esm/index.js",
  "jsdelivr": "dist/lib.esm/index.js",
  "types": "dist/lib.cjs/index.d.ts",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tkey/tkey.git"
  },
  "scripts": {
    "test": "vp test run --config ../../test/shared/node.mocked.mts --coverage",
    "coverage": "vp test run --config ../../test/shared/node.mocked.mts --coverage",
    "coverage-production": "vp test run --config ../../test/shared/node.prod.mts --coverage",
    "test-development": "vp test run --config ../../test/shared/node.dev.mts",
    "test-production": "vp test run --config ../../test/shared/node.prod.mts",
    "test-debugger": "vp test run --config ../../test/shared/node.debug.mts --inspect-brk",
    "dev": "vp pack --watch",
    "build": "vp pack",
    "lint": "vp lint",
    "prepack": "npm run build",
    "pre-commit": "lint-staged"
  },
  "dependencies": {
    "@tkey/common-types": "^17.2.0",
    "@toruslabs/http-helpers": "^10.0.0",
    "@toruslabs/metadata-helpers": "^9.0.0",
    "json-stable-stringify": "^1.3.0"
  },
  "devDependencies": {
    "@types/json-stable-stringify": "^1.2.0"
  },
  "bugs": {
    "url": "https://github.com/tkey/tkey/issues"
  },
  "lint-staged": {
    "!(*d).ts": [
      "vp fmt",
      "vp lint --fix"
    ]
  },
  "engines": {
    "node": ">=24.22.0",
    "npm": ">=12"
  },
  "gitHead": "4ff88f7fe92b8c85bd0bfde069cde2e56005faca",
  "devEngines": {
    "packageManager": {
      "name": "npm",
      "version": ">=11.17.0",
      "onFail": "error"
    }
  }
}
