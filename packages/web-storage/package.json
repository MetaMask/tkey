{
  "name": "@tkey/web-storage",
  "version": "17.2.0",
  "description": "TKey Web Storage Module",
  "author": "Torus Labs",
  "homepage": "https://github.com/tkey/tkey#readme",
  "license": "MIT",
  "main": "dist/lib.cjs/index.js",
  "module": "dist/lib.esm/index.js",
  "unpkg": "dist/lib.esm/index.js",
  "jsdelivr": "dist/lib.esm/index.js",
  "types": "dist/lib.cjs/index.d.ts",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tkey/tkey.git"
  },
  "scripts": {
    "test:browser": "vp test run --config ../../test/shared/browsers.mocked.mts --project Chrome",
    "test": "vp test run --config ../../test/shared/browsers.mocked.mts --project Chrome --coverage",
    "coverage": "vp test run --config ../../test/shared/browsers.mocked.mts --coverage --project Chrome",
    "coverage-production": "vp test run --config ../../test/shared/browsers.prod.mts --coverage --project Chrome",
    "test-development": "vp test run --config ../../test/shared/browsers.dev.mts --project Chrome",
    "test-production": "vp test run --config ../../test/shared/browsers.prod.mts --project Chrome",
    "node-tests:local-mocked": "vp test run --config ../../test/shared/node.mocked.mts",
    "browser-tests:local-mocked": "vp test run --config ../../test/shared/browsers.mocked.mts --project Chrome",
    "browser-tests:local-dev": "vp test run --config ../../test/shared/browsers.dev.mts --project Chrome",
    "browser-tests:local-prod": "vp test run --config ../../test/shared/browsers.prod.mts --project Chrome",
    "browser-tests:cloud-mocked": "vp test run --config ../../test/shared/browsers.mocked.mts --project Chrome",
    "browser-tests:cloud-prod": "vp test run --config ../../test/shared/browsers.prod.mts --project Chrome",
    "test-debugger": "vp test run --config ../../test/shared/node.debug.mts --inspect-brk",
    "dev": "vp pack --watch",
    "build": "vp pack",
    "lint": "vp lint",
    "prepack": "npm run build",
    "pre-commit": "lint-staged"
  },
  "dependencies": {
    "@tkey/common-types": "^17.2.0"
  },
  "devDependencies": {
    "@tkey/core": "^17.2.0",
    "@tkey/service-provider-base": "^17.2.0",
    "@tkey/storage-layer-torus": "^17.2.0",
    "@types/filesystem": "^0.0.36"
  },
  "bugs": {
    "url": "https://github.com/tkey/tkey/issues"
  },
  "lint-staged": {
    "!(*d).ts": [
      "vp fmt",
      "vp lint --fix"
    ]
  },
  "engines": {
    "node": ">=24.22.0",
    "npm": ">=12"
  },
  "gitHead": "4ff88f7fe92b8c85bd0bfde069cde2e56005faca",
  "devEngines": {
    "packageManager": {
      "name": "npm",
      "version": ">=11.17.0",
      "onFail": "error"
    }
  }
}
