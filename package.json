{
  "name": "tkey",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "vp run -r --fail-if-no-match build",
    "dev": "vp run -r --fail-if-no-match dev",
    "test": "vp run -r --fail-if-no-match --parallel test",
    "test:cov": "vp run -r --fail-if-no-match --parallel coverage",
    "test-development": "vp run -r --fail-if-no-match --parallel test-development",
    "test-production": "vp run -r --fail-if-no-match test-production",
    "test-production:cov": "vp run -r --fail-if-no-match coverage-production",
    "test-debugger": "vp run -r --fail-if-no-match --parallel test-debugger",
    "browser-tests:local-mocked": "vp run -r --fail-if-no-match --parallel browser-tests:local-mocked",
    "browser-tests:local-prod": "vp run -r --fail-if-no-match browser-tests:local-prod",
    "browser-tests:local-dev": "vp run -r --fail-if-no-match --parallel browser-tests:local-dev",
    "browser-tests:cloud-mocked": "vp run -r --fail-if-no-match browser-tests:cloud-mocked",
    "browser-tests:cloud-prod": "vp run -r --fail-if-no-match browser-tests:cloud-prod",
    "lint": "vp run -r --fail-if-no-match lint",
    "check": "vp check",
    "typecheck": "for dir in packages/*; do npm exec --no -- tsc --noEmit -p \"$dir/tsconfig.json\" || exit 1; done",
    "pack": "npm exec --workspaces -- npm pack",
    "pre-commit": "lint-staged",
    "version-packages": "changeset version && npm install --package-lock-only --ignore-scripts",
    "release-packages": "changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "@lavamoat/harden": "^0.8.1",
    "@toruslabs/config": "^5.0.0",
    "@toruslabs/oxlint-config-typescript": "^1.1.0",
    "@toruslabs/torus-scripts": "^9.0.1",
    "@types/node": "^26.6.6",
    "@vitest/browser-playwright": "5.1.0",
    "@vitest/coverage-istanbul": "5.1.0",
    "cross-env": "^10.1.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "playwright": "^1.65.0",
    "typescript": "^7.0.2",
    "vite-plus": "1.5.1"
  },
  "author": "Torus Labs",
  "license": "MIT",
  "engines": {
    "node": ">=24.22.0",
    "npm": ">=12"
  },
  "devEngines": {
    "packageManager": {
      "name": "npm",
      "version": ">=11.17.0",
      "onFail": "error"
    }
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@1.5.1",
    "vitest": "5.1.0"
  },
  "allowScripts": {
    "fsevents@2.3.3": false
  }
}
